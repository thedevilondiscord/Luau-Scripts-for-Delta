local function pushChatLine(sender: string, msg: string, badge: string?)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BorderSizePixel = 0
	row.Parent = MessageStream
	round(row, 12)
	hairStroke(row, theme.Stroke, 0.92, 1)

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 7)
	pad.PaddingBottom = UDim.new(0, 7)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = row

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, 0, 0, 0)
	txt.AutomaticSize = Enum.AutomaticSize.Y
	txt.BackgroundTransparency = 1
	txt.RichText = true
	txt.TextWrapped = true
	txt.Font = Enum.Font.GothamMedium
	txt.TextSize = 12
	txt.TextXAlignment = Enum.TextXAlignment.Left

	local badgeStr = badge and string.format(" <font size=\"10\">[%s]</font>", badge) or ""
	txt.Text = string.format("<b>%s</b>%s  %s", sender, badgeStr, msg)
	txt.Parent = row

	row.BackgroundColor3 = theme.CardBg
	txt.TextColor3 = theme.Text

	task.defer(function()
		MessageStream.CanvasPosition = Vector2.new(0, MessageStream.AbsoluteCanvasSize.Y)
	end)
end

local function sendComposer()
	local clean = ComposerInput.Text:match("^%s*(.-)%s*$")
	if not clean or clean == "" then
		return
	end
	ComposerInput.Text = ""
	if SaikiRechat.Chat.OnSend then
		SaikiRechat.Chat.OnSend(clean)
	else
		pushChatLine(LocalPlayer.Name, clean, "Chat")
	end
end

SendPill.MouseButton1Click:Connect(sendComposer)
ComposerInput.FocusLost:Connect(function(enter: boolean)
	if enter then
		sendComposer()
	end
end)

FilterBox:GetPropertyChangedSignal("Text"):Connect(function()
	local q = FilterBox.Text:lower()
	for _, child in ipairs(MessageStream:GetChildren()) do
		if child:IsA("Frame") then
			local lbl = child:FindFirstChildOfClass("TextLabel")
			if lbl then
				rowVisible = (q == "") or (lbl.Text:lower():find(q, 1, true) ~= nil)
				child.Visible = rowVisible
			end
		end
	end
end)

