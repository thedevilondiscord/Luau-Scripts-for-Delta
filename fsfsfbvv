        ),
        {
            Position = UDim2.new(
                0.5,
                -135,
                1,
                -42
            )
        }
    ):Play()

    task.delay(2.1, function()

        if thisToast ~= toastSerial then
            return
        end

        TweenService:Create(
            Toast,
