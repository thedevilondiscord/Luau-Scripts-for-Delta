----------------------------------------------------------------
-- REMOTE CALL
----------------------------------------------------------------

local function fireRemote(
    remote,
    ...
)

    if not remote then
        return false
    end

    local args = {...}

    local ok = pcall(function()

        if remote:IsA(
            "RemoteEvent"
        ) then

            remote:FireServer(
                unpack(args)
            )

        elseif remote:IsA(
            "RemoteFunction"
        ) then

            remote:InvokeServer(
                unpack(args)
            )
        end
    end)

    return ok
end

