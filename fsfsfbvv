statusPanel(musicPage, "YouTube Music Sessions", "Queue, playlists and synchronized listening.", "The Kronos reference uses a remote Pastefy loadstring engine for YouTube audio. This build does not execute that unverified remote code. No MP3 downloading is included; YouTube URL parsing and synchronized playback need a vetted audio engine first.")
local ytInput = textBox(musicPage, "Paste YouTube video or playlist URL...", UDim2.new(1, 0, 0, 38))
local musicActions = create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38)}, musicPage)
create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8)}, musicActions)
local function youtubeId(url)
    url = tostring(url or "")
    return url:match("youtu%.be/([%w_-]+)") or url:match("youtube%.com/watch%?.-v=([%w_-]+)") or url:match("youtube%.com/shorts/([%w_-]+)")
end
button(musicActions, "Validate URL", function()
    local id = youtubeId(ytInput.Text)
    if id then warn("[KNOWN HANGOUT] Valid YouTube video ID: " .. id .. ". Playback engine is not enabled in V1.")
    elseif ytInput.Text:find("youtube%.com/playlist%?") then warn("[KNOWN HANGOUT] Playlist URL detected. Playlist expansion requires the vetted engine.")
    else warn("[KNOWN HANGOUT] Enter a YouTube video or playlist URL.") end
end, 112)
button(musicActions, "Clear", function() ytInput.Text = "" end, 72)
local musicQueueNote = label(musicPage, "Queue and session controls are intentionally inactive until a safe playback engine and Music DB API key are configured.", 11, C.sub)
