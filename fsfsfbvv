local function appendChatBubble(author: string, text: string, tag: string?)
	local bubble = Instance.new("Frame")
	bubble.Size = UDim2.new(1, 0, 0, 0)
	bubble.AutomaticSize = Enum.AutomaticSize.Y
	bubble.BorderSizePixel = 0
	bubble.Parent = ChatFeed
	addCorner(bubble, 6)

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = bubble

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.BackgroundTransparency = 1
	label.TextWrapped = true
	label.RichText = true
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left

	local tagPart = tag and (" [" .. tag .. "]") or ""
	label.Text = string.format("<b>%s%s:</b> %s", author, tagPart, text)
	label.Parent = bubble

	-- Apply current theme colors to new bubble
	bubble.BackgroundColor3 = currentTheme.SurfaceElevated
	label.TextColor3 = currentTheme.TextPrimary

	task.defer(function()
		ChatFeed.CanvasPosition = Vector2.new(0, ChatFeed.AbsoluteCanvasSize.Y)
	end)
end

local function submitChat()
	local msg = ChatBox.Text:match("^%s*(.-)%s*$")
	if not msg or msg == "" then
		return
	end
	ChatBox.Text = ""

	if SaikiRechatUI.Chat.OnSendMessage then
		SaikiRechatUI.Chat.OnSendMessage(msg)
	else
		appendChatBubble(LocalPlayer.Name, msg, "Local")
	end
end

SendBtn.MouseButton1Click:Connect(submitChat)
ChatBox.FocusLost:Connect(function(enterPressed: boolean)
	if enterPressed then
		submitChat()
	end
end)

SaikiRechatUI.Chat.AppendMessage = appendChatBubble

