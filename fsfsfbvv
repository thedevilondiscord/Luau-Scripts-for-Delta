local function dmHandler(key, m)
	local uid = tostring(m.uid or "")
	if uid ~= ME and uid ~= dm.partner then return end
	if banned[tonumber(uid)] or (T.isMuted and T.isMuted(uid)) then return end
	local st = toStored(key, m)
	if not st then return end
	if activeConv then activeConv[#activeConv + 1] = st; activeDirty = true end
	local e = touchIndex(dm.partner, st, dm.name)
	if isOpen and cur == 2 and thread.Visible then e.r = st.k end -- I'm looking at it: counts as read
	renderStored(st)
	if uid ~= ME and not (isOpen and cur == 2 and thread.Visible) and T.notify then
		T.notify("dm" .. tostring(dm.partner), "New DM  ·  " .. tostring(dm.name or "Someone"), st.s and "Sticker" or st.t)
	end
end

function openThread(id, name, user)
	if closePicker then closePicker() end
	dm.partner, dm.name = id, name
	local pair = pairKey(ME, id)
	activeConv, activeDirty = loadConv(id), false
	dmStream = newStream("/dm/" .. pair, dmAuth, DM_FIREBASE_DB)
	dmStream.rpath = "/dmreact/" .. pair
	views.dm.clear()
	-- 1) draw what's already on this device (no network)
	for _, st in ipairs(activeConv) do dmStream.seen[st.k] = true end -- so Firebase's copy is never drawn twice
	if #activeConv > 0 then dmStream.last = activeConv[#activeConv].k; dmStream.primed = true end
	for i = math.max(1, #activeConv - CONFIG.DM_SHOW + 1), #activeConv do renderStored(activeConv[i]) end
	dmTitle.Text, dmAv.Image = name, thumb(id)
	if FS.onThread then FS.onThread(id, name, user) end
	home.Visible, thread.Visible = false, true
	if not REQUEST then views.dm.notice("Local demo mode: messages stay on your device.") end
	local e = touchIndex(id, nil, name, user)
	if e.l then e.r = e.l end
	refreshUnread()
	-- 2) ask Firebase only for what's newer than the last local message
	task.spawn(function() T.dmId(); pollStream(dmStream, dmHandler) end)
end
