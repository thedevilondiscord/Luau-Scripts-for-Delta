local function make(className: string, props: {[string]: any}, parent: Instance?): Instance
    local object = Instance.new(className)
    for key, value in pairs(props) do
        (object :: any)[key] = value
    end
    if parent then object.Parent = parent end
    return object
end

local function corner(parent: Instance, radius: number)
    make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent: Instance, color: Color3?, transparency: number?)
    make("UIStroke", {
        Color = color or Theme.Border,
        Transparency = transparency or 0,
        Thickness = 1,
    }, parent)
end

local function tween(object: Instance, duration: number, properties: {[string]: any})
    TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties):Play()
end

local function label(parent: Instance, text: string, size: number, bold: boolean, color: Color3?): TextLabel
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
        TextSize = size,
        TextColor3 = color or Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 0, size + 8),
    }, parent) :: TextLabel
end

local function button(parent: Instance, text: string, size: UDim2, color: Color3?): TextButton
    local b = make("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = color or Theme.Panel2,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        Size = size,
    }, parent) :: TextButton
    corner(b, 12)
    stroke(b, Theme.Border, 0.35)
    b.MouseEnter:Connect(function()
        tween(b, 0.14, { BackgroundColor3 = Theme.Accent })
    end)
    b.MouseLeave:Connect(function()
        tween(b, 0.14, { BackgroundColor3 = color or Theme.Panel2 })
    end)
    return b
end

local function panel(parent: Instance, size: UDim2, position: UDim2): Frame
    local f = make("Frame", {
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0,
        Size = size,
        Position = position,
    }, parent) :: Frame
    corner(f, 16)
    stroke(f, Theme.Border, 0.2)
    return f
end

