----------------------------------------------------------------
-- NEXT
----------------------------------------------------------------

local function nextSong()

    -- Queue takes priority.

    if #State.queue > 0 then

        local nextItem =
            table.remove(
                State.queue,
                1
            )

        playSong(
            nextItem
        )

        return
    end

    if #State.songs == 0 then
        return
    end

    if State.shuffle
        and #State.songs > 1 then

        local nextIndex =
            State.index

        repeat

            nextIndex =
                math.random(
                    1,
                    #State.songs
                )

        until nextIndex ~=
            State.index

        State.index =
            nextIndex

    else

        State.index =
            State.index + 1

        if State.index >
            #State.songs then

            State.index = 1
        end
    end

    playSong(
        State.songs[
            State.index
        ]
    )
end

----------------------------------------------------------------
-- PREVIOUS
----------------------------------------------------------------

local function previousSong()

    if not State.current then
        return
    end

    if MusicSound.TimePosition > 4 then

        pcall(function()
            MusicSound.TimePosition = 0
        end)

        vehiclePlayMusic(
            State.current.id
        )

        showToast(
            "Restarted"
        )

        return
    end

    State.index =
        State.index - 1

    if State.index < 1 then
        State.index =
            #State.songs
    end

    playSong(
        State.songs[
            State.index
        ]
    )
end

