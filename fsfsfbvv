local function formatTime(seconds: number): string
    local safe = math.max(0, math.floor(seconds))
    return string.format("%d:%02d", math.floor(safe / 60), safe % 60)
end

local function updateTrack()
    local track = Music.Playlist[Music.Index]
    if not track then
        trackTitle.Text = "No track selected"
        artistLabel.Text = "Add tracks through Music.SetPlaylist()"
        Music.Sound:Stop()
        return
    end
    trackTitle.Text = track.title
    artistLabel.Text = track.artist
    Music.Sound.SoundId = track.soundId
    Music.Sound.TimePosition = 0
    if Music.OnTrackChanged then Music.OnTrackChanged(Music.Index, track) end
end

function Music.SetPlaylist(tracks: {{title: string, artist: string, soundId: string}})
    Music.Playlist = tracks
    Music.Index = 1
    updateTrack()
end

function Music.SetArtwork(imageId: string)
    artwork.Image = imageId
end

function Music.Play()
    if #Music.Playlist == 0 then return end
    if Music.Sound.SoundId == "" then updateTrack() end
    Music.Sound:Play()
    playPause.Text = "PAUSE"
    playbackLabel.Text = "PLAYING"
    if Music.OnPlaybackChanged then Music.OnPlaybackChanged(true) end
end

function Music.Pause()
    Music.Sound:Pause()
    playPause.Text = "PLAY"
    playbackLabel.Text = "PAUSED"
    if Music.OnPlaybackChanged then Music.OnPlaybackChanged(false) end
end

function Music.Next()
    if #Music.Playlist == 0 then return end
    Music.Index = (Music.Index % #Music.Playlist) + 1
    updateTrack()
    Music.Play()
end

function Music.Previous()
    if #Music.Playlist == 0 then return end
    Music.Index = ((Music.Index - 2) % #Music.Playlist) + 1
    updateTrack()
    Music.Play()
end

prev.Activated:Connect(Music.Previous)
nextButton.Activated:Connect(Music.Next)
playPause.Activated:Connect(function()
    if Music.Sound.IsPlaying then Music.Pause() else Music.Play() end
end)
Music.Sound.Ended:Connect(Music.Next)

RunService.Heartbeat:Connect(function()
    local duration = Music.Sound.TimeLength
    local position = Music.Sound.TimePosition
    local ratio = duration > 0 and math.clamp(position / duration, 0, 1) or 0
    progressFill.Size = UDim2.fromScale(ratio, 1)
    elapsedLabel.Text = formatTime(position)
    durationLabel.Text = formatTime(duration)
end)

