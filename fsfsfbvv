			AnchorPoint = Vector2.new(1, 0.5),
		}, loader)
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }) }, f)
		table.insert(shoots, { f = f, x = -1, y = 0, t = rng:NextNumber(0, 2.5) })
	end

	new("TextLabel", {
		Text = "WELCOME TO", Font = Enum.Font.GothamMedium, TextSize = 20, TextColor3 = Color3.fromRGB(190, 190, 215), BackgroundTransparency = 1,
		ZIndex = 103, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.40), Size = UDim2.fromOffset(400, 26),
	}, loader)
	local loadTitle = new("TextLabel", {
		Text = "KNOWN GFX", Font = Enum.Font.GothamBold, TextSize = 50, TextColor3 = rgb, BackgroundTransparency = 1, ZIndex = 103,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(500, 60),
	}, loader)
	local loadTrack = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromOffset(260, 6),
		BackgroundColor3 = C.field, BorderSizePixel = 0, ZIndex = 103,
	}, loader)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, loadTrack)
	local loadFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = rgb, BorderSizePixel = 0, ZIndex = 104 }, loadTrack)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, loadFill)
	new("TextLabel", {
		Text = "made by kai", Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Color3.fromRGB(150, 150, 172), BackgroundTransparency = 1,
		ZIndex = 103, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.65), Size = UDim2.fromOffset(300, 18),
	}, loader)

	local DUR = 3.5
	local t0 = os.clock()
	local lc
	local function finish()
		if lc then lc:Disconnect() lc = nil end
		loader:Destroy()
		main.Visible = true
		circle.Visible = true
		pcall(function()
			local TCS = game:GetService("TextChatService")
			local msg = "KNOWN GFX SCRIPT LOADED"
			if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
				local ch = TCS:FindFirstChild("TextChannels") and TCS.TextChannels:FindFirstChild("RBXGeneral")
				if ch then ch:SendAsync(msg) end
			else
				local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
				if ev then ev.SayMessageRequest:FireServer(msg, "All") end
			end
		end)
	end
	lc = track(RS.Heartbeat:Connect(function(dt)
		local el = os.clock() - t0
		loadFill.Size = UDim2.fromScale(math.min(el / DUR, 1), 1)
		loadFill.BackgroundColor3 = rgb
		loadTitle.TextColor3 = rgb
		for k, gl in ipairs(glows) do
			gl.Position = gl.Position + UDim2.fromScale(math.sin(el * 0.6 + k) * 0.0004, math.cos(el * 0.5 + k) * 0.0004)
		end
		for _, st in ipairs(stars) do
			st.y = st.y + st.v * dt
			st.x = st.x - st.v * 0.25 * dt
			if st.y > 1.02 then st.y = -0.02; st.x = rng:NextNumber() end
			if st.x < -0.02 then st.x = 1.02 end
			st.f.Position = UDim2.fromScale(st.x, st.y)
			st.f.BackgroundTransparency = 0.25 + 0.4 * (0.5 + 0.5 * math.sin(el * st.s * 3))
		end
		for _, sh in ipairs(shoots) do
			sh.t = sh.t - dt
			if sh.t <= 0 then
				sh.x, sh.y, sh.t = rng:NextNumber(0.3, 1.1), rng:NextNumber(-0.1, 0.3), rng:NextNumber(1.5, 3.5)
			end
			sh.x = sh.x - dt * 0.9
			sh.y = sh.y + dt * 0.63
			sh.f.Position = UDim2.fromScale(sh.x, sh.y)
		end
		if el >= DUR then finish() end
	end))
end
