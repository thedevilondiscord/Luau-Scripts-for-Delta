local function sendChat()
    local message = string.gsub(ChatInput.Text, "^%s*(.-)%s*$", "%1")
    if message == "" then return end
    ChatInput.Text = ""
    if Chat.OnSend then
        Chat.OnSend(message)
    else
        warn("[SaikiKnownGFX] Chat.OnSend is not connected; message was not transmitted.")
    end
end
