-- Swipe/drag on empty sheet space; native ScrollingFrame also handles touch.
local dragging, dragStart, canvasStart = false, nil, 0
HOST.Sheet.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        canvasStart = HOST.Sheet.CanvasPosition.X
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position.X - dragStart.X
        HOST.Sheet.CanvasPosition = Vector2.new(math.clamp(canvasStart - delta, 0, 1520), 0)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        dragStart = nil
    end
end)

-- Keep a lightweight viewport-aware canvas width on orientation changes.
local function updateViewport()
    local cam = workspace.CurrentCamera
    if not cam then return end
    HOST.Sheet.CanvasSize = UDim2.fromOffset(2280, 0)
end
if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewport)
end


