end

-- Tabs
local sections = {
	Chat = ChatSection,
	Music = MusicSection,
}
local tabs: { [string]: TextButton } = {}

local function openTab(name: string)
	SectionLabel.Text = "SAIKIRECHAT // " .. name:upper()
	for k, frame in pairs(sections) do
		frame.Visible = (k == name)
	end
	for k, btn in pairs(tabs) do
		local active = (k == name)
		TweenService:Create(btn, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = active and Theme.AccentDim or Theme.Elevated,
			TextColor3 = active and Theme.Accent or Theme.Subtext,
		}):Play()
	end
end

for _, name in ipairs({ "Chat", "Music" }) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(68, 24)
	btn.Text = name:upper()
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 10
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.Parent = TabBar
	pill(btn)
	btn.MouseButton1Click:Connect(function()
		openTab(name)
	end)
	tabs[name] = btn
end

openTab("Chat")

