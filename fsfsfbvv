local function applyTheme(themeName: string)
	local chosen = Themes[themeName]
	if not chosen then
		return
	end
	currentThemeName = themeName
	currentTheme = chosen

	MainFrame.BackgroundColor3 = chosen.Background
	TopBar.BackgroundColor3 = chosen.Surface
	Sidebar.BackgroundColor3 = chosen.Surface
	TitleLabel.TextColor3 = chosen.TextPrimary

	CloseButton.BackgroundColor3 = chosen.SurfaceElevated
	CloseButton.TextColor3 = chosen.TextPrimary

	ToggleButton.BackgroundColor3 = chosen.Surface
	ToggleButton.TextColor3 = chosen.Accent
	toggleStroke.Color = chosen.Border
	mainStroke.Color = chosen.Border

	ChatFeed.BackgroundColor3 = chosen.Surface
	chatFeedStroke.Color = chosen.Border
	ChatInputBar.BackgroundColor3 = chosen.SurfaceElevated
	chatInputStroke.Color = chosen.Border
	ChatBox.TextColor3 = chosen.TextPrimary
	ChatBox.PlaceholderColor3 = chosen.TextSecondary
	SendBtn.BackgroundColor3 = chosen.Accent
	SendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

	for _, child in ipairs(ChatFeed:GetChildren()) do
		if child:IsA("Frame") then
			child.BackgroundColor3 = chosen.SurfaceElevated
			local lbl = child:FindFirstChildOfClass("TextLabel")
			if lbl then
				lbl.TextColor3 = chosen.TextPrimary
			end
		end
	end

	MusicCard.BackgroundColor3 = chosen.Surface
	musicCardStroke.Color = chosen.Border
	TrackTitle.TextColor3 = chosen.TextPrimary
	TrackArtist.TextColor3 = chosen.TextSecondary
	TimeLabel.TextColor3 = chosen.TextSecondary
	ProgressBg.BackgroundColor3 = chosen.SurfaceElevated
	ProgressFill.BackgroundColor3 = chosen.Accent

	for _, ctrl in ipairs({ PrevBtn, PlayBtn, NextBtn }) do
		ctrl.BackgroundColor3 = chosen.SurfaceElevated
		ctrl.TextColor3 = chosen.TextPrimary
	end
	PlayBtn.BackgroundColor3 = chosen.Accent
	PlayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

	ThemeTitle.TextColor3 = chosen.TextPrimary

	-- Highlight active nav button
	local activeTab = "Chat"
	for pageKey, pageFrame in pairs(pages) do
		if pageFrame.Visible then
			activeTab = pageKey
			break
		end
	end
	for btnKey, navBtn in pairs(navButtons) do
		local isActive = (btnKey == activeTab)
		navBtn.BackgroundColor3 = isActive and chosen.Accent or chosen.SurfaceElevated
		navBtn.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or chosen.TextSecondary
	end
end

for themeKey in pairs(Themes) do
