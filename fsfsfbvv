do
	local text = "Pick any frame you have unlocked: the frames of your Tier and every lower Tier, plus any secret frame a moderator gave you. Everyone sees the one you pick. Auto = the frame of your own Tier."
	local dh = textH(text, 12, TW)
	local c = card(33 + dh + 10 + 30 + 12)
	local y = title(c, "Your frame")
	desc(c, text, y, TW)
	local grid = new("Frame", { Position = UDim2.fromOffset(12, y + dh + 10), Size = UDim2.new(1, -24, 0, 30), BackgroundTransparency = 1, Parent = c }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 28), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local chips = {}
	local build
	build = function()
		for _, ch in ipairs(chips) do ch:Destroy() end
		chips = {}
		local opts = T.frameOptions and T.frameOptions(H.me) or {}
		local cur = (T.frameChoice and T.frameChoice[H.me]) or "auto"
		if type(cur) == "number" then cur = (cur == 2) and "t4b" or "t4a" end
		for i, o in ipairs(opts) do
			local sel = (o.key == cur)
			local btn = new("TextButton", { BackgroundColor3 = WHITE, BackgroundTransparency = sel and 0.8 or 0.94, Text = o.label, Font = T.fontB,
				TextSize = 12, TextColor3 = T.text, AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = i, Parent = grid }, { corner(12) })
