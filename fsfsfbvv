local viewMap = {
	Chat = ChatView,
	Music = MusicView,
	Style = StyleView,
}
local pillButtons: { [string]: TextButton } = {}
local currentMode = "Chat"

local function selectMode(modeName: string)
	currentMode = modeName
	DeckTitle.Text = "SAIKIRECHAT  ·  " .. modeName:upper()
	for name, frame in pairs(viewMap) do
		frame.Visible = (name == modeName)
	end
	for name, btn in pairs(pillButtons) do
		local active = (name == modeName)
		tween(btn, {
			BackgroundColor3 = active and theme.AccentSoft or theme.CardBg,
			TextColor3 = active and theme.Text or theme.Muted,
		}, 0.14)
	end
end

for _, modeName in ipairs({ "Chat", "Music", "Style" }) do
	local pBtn = Instance.new("TextButton")
	pBtn.Size = UDim2.fromOffset(66, 26)
	pBtn.Text = modeName:upper()
