local function httpGet(url)
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)

    if ok and type(result) == "string" then
        return result
    end

    local requestFn =
        (syn and syn.request)
        or (http and http.request)
        or http_request
        or request

    if type(requestFn) == "function" then
        local success, response = pcall(function()
            return requestFn({
                Url = url,
                Method = "GET"
            })
        end)

        if success and response then
            return response.Body or response.body
        end
    end

    return nil
end

----------------------------------------------------------------
-- SONG NORMALIZER
----------------------------------------------------------------

local function normalizeSong(item)
    if type(item) ~= "table" then
        return nil
    end

    local id =
        item.id
        or item.ID
        or item.Id
        or item.assetId
        or item.AssetId

    local name =
        item.name
        or item.Name
        or item.title
        or item.Title

    local category =
        item.category
        or item.Category

    local cover =
        item.cover
        or item.coverImage
        or item.image
        or item.thumbnail
        or item.thumbnailId

    if not id then
        return nil
    end

    id = tostring(id)

    if not id:match("^%d+$") then
        return nil
    end

    name = tostring(
        name
        or "Untitled Track"
    )

    category = tostring(
        category
        or "Other"
    )

    if category ~= "Phonk"
        and category ~= "Hindi"
        and category ~= "Bhojpuri"
        and category ~= "English"
        and category ~= "Other" then

        category = "Other"
    end

    return {
        id = id,
        name = name,
        category = category,
        cover = cover
    }
end

