;(function()
	local assets, loading = {}, {}
	local reg = setmetatable({}, { __mode = "k" })    -- avatar image -> { uid, img }
	local hooked = setmetatable({}, { __mode = "k" })
	for _, d in ipairs(CONFIG.FRAMES2 or {}) do
		CONFIG.FRAMES["x_" .. d.id] = { file = d.file, repo = CONFIG.FRAMES2_REPO, w = d.w, h = d.h, cx = d.cx, cy = d.cy, r = d.r }
	end
	ensureFolder(CACHE .. "/frames")
	T.frameChoice = {}                                 -- [userId] = frame key the player picked (or an old 1 / 2)

	local FNAMES = { t2 = "Tier II", t3 = "Tier III", t4a = "Tier IV-1", t4b = "Tier IV-2", t5 = "Tier V", rose = "Roses", cursed = "Cursed", demon = "Demon" }
	local function frameLabel(k) return FNAMES[k] or tostring(k):gsub("^x_", "") end
	T.granted = T.granted or {}                        -- [userId] = { [secretFrameKey] = true }  (given by moderators)

	local function tierOfId(id)                        -- nil = unknown yet
		local cnt = T.boardCount and T.boardCount(id)
		if cnt == nil then
			if T.boardLoaded and not T.boardLoaded() and T.boardNeeded then T.boardNeeded() end
			local c = FS.cache and FS.cache[id]
			cnt = c and c.c or nil
		end
		return cnt and FS.tierOf(cnt) or nil
	end
	local function tierFrames(tier)                    -- every tier frame up to (and including) this tier, lowest first
		local out = {}
		for t = 2, tier do
			local k = CONFIG.TIER_FRAMES and CONFIG.TIER_FRAMES[t]
			if type(k) == "table" then for _, x in ipairs(k) do out[#out + 1] = x end elseif k then out[#out + 1] = k end
		end
		return out
	end
	local function staticSecret(id)
		local n = tonumber(id)
		local k = n and CONFIG.FRAME_USERS and CONFIG.FRAME_USERS[n]
		return (k and CONFIG.FRAMES[k]) and k or nil
	end

	-- which frame does this user wear right now? (nil = none)
	-- their own pick if they are allowed to wear it (their Tier or lower, or a secret frame a moderator gave them), else the frame of their Tier
	function T.frameKeyFor(id)
		if T.frameTest then return T.frameTest end     -- local test from the aura test panel
		id = tostring(id)
		local tier = tierOfId(id)
		local choice = T.frameChoice[id]
		if type(choice) == "number" then choice = (choice == 2) and "t4b" or ((choice == 1) and "t4a" or nil) end -- old Tier IV picks
		if choice == "none" then return nil end
		if choice and CONFIG.FRAMES[choice] then
			local allowed = (T.granted[id] and T.granted[id][choice]) or staticSecret(id) == choice
			if not allowed and tier then
				for _, k in ipairs(tierFrames(tier)) do if k == choice then allowed = true; break end end
			end
			if allowed then return choice end
		end
		local sec = staticSecret(id)
		if sec then return sec end
		if not tier then return nil end
		local k = CONFIG.TIER_FRAMES and CONFIG.TIER_FRAMES[tier]
		if type(k) == "table" then return k[1] end
		return k
	end

	-- everything this user may pick (Auto, No frame, frames of their tier and below, secret frames they were given)
	function T.frameOptions(id)
		id = tostring(id)
		local opts, seen = { { key = "auto", label = "Auto" }, { key = "none", label = "No frame" } }, {}
		local function add(k) if k and CONFIG.FRAMES[k] and not seen[k] then seen[k] = true; opts[#opts + 1] = { key = k, label = frameLabel(k) } end end
		local tier = tierOfId(id)
		if tier then for _, k in ipairs(tierFrames(tier)) do add(k) end end
		add(staticSecret(id))
		local keys = {}
		for k in pairs(T.granted[id] or {}) do keys[#keys + 1] = k end
		table.sort(keys)
		for _, k in ipairs(keys) do add(k) end
		return opts
	end

	-- the logged-in player picks a frame (key from T.frameOptions, or "auto"): saved in the DM database so everyone sees it
	function T.setFrameChoice(key)
		local valid = (key == "auto")
		if not valid then for _, o in ipairs(T.frameOptions(ME)) do if o.key == key then valid = true; break end end end
		if not valid then return false end
		T.frameChoice[ME] = (key ~= "auto") and key or nil
		if T.refreshFrames then pcall(T.refreshFrames) end
		if not REQUEST then return true end
		T.dmId()
		local ok, code
		if key == "auto" then
			ok, _, _, code = dbRequest("DELETE", "/frames/" .. ME, nil, dmAuth, DM_FIREBASE_DB)
		else
			ok, _, _, code = dbRequest("PUT", "/frames/" .. ME, '"' .. key .. '"', dmAuth, DM_FIREBASE_DB)
		end
		return ok and true or false, code
	end

	local function startLoad(key)
		if assets[key] ~= nil or loading[key] then return end
		local def = CONFIG.FRAMES[key]
		if not def then return end
		loading[key] = true
		task.spawn(function()
			local url = "https://raw.githubusercontent.com/" .. GITHUB_OWNER .. "/" .. (def.repo or "Frames-XD") .. "/main/" .. enc(def.file)
			local path = CACHE .. "/frames/" .. key .. ".png"
			local a = limited(function() return cachedAsset(url, path) end)
			loading[key] = nil
			if a then
				assets[key] = a
				if alive and T.refreshFrames then pcall(T.refreshFrames) end
			else
				assets[key] = false
				task.delay(60, function() assets[key] = nil end) -- try again later
			end
		end)
	end

	local function apply(o, rec)
		local key = T.frameKeyFor(rec.uid)
		local def = key and CONFIG.FRAMES[key]
		local a = def and assets[key]
		if def and a == nil then startLoad(key) end
		if not a then
			if rec.img then rec.img:Destroy(); rec.img = nil end
			return
		end
		if not (rec.img and rec.img.Parent == o) then
			if rec.img then rec.img:Destroy() end
			rec.img = new("ImageLabel", { Name = "SaikiFrame", BackgroundTransparency = 1, Active = false, Image = "", Parent = o })
		end
		local s = (CONFIG.FRAME_FIT or 0.95) / (2 * def.r) -- fraction of the avatar's size per image pixel
		local adj = T.frameAdj and T.frameAdj[key]        -- tester adjustments from the !atp panel (nil for everyone else)
		local dx, dy = 0, 0
		if adj then s = s * (adj.sz or 1); dx, dy = adj.dx or 0, adj.dy or 0 end
		rec.img.ZIndex = o.ZIndex + 1
		rec.img.Image = a
		rec.img.Size = UDim2.fromScale(def.w * s, def.h * s)
		rec.img.Position = UDim2.fromScale(0.5 - def.cx * s + dx, 0.5 - def.cy * s + dy)
	end

	function T.refreshFrames()
		for o, rec in pairs(reg) do
			if o.Parent then pcall(apply, o, rec) else reg[o] = nil end
		end
	end

	-- every Roblox headshot picture anywhere in the window gets its owner's frame (also pictures created later or changed later)
	local function hook(o)
		if hooked[o] or o.Name == "SaikiFrame" then return end
		if not (o:IsA("ImageLabel") or o:IsA("ImageButton")) then return end
		hooked[o] = true
		local function check()
			local id = tostring(o.Image):match("AvatarHeadShot&id=(%d+)")
			local rec = reg[o]
			if id then
				if not rec then rec = { uid = id }; reg[o] = rec end
				rec.uid = id
				pcall(apply, o, rec)
			elseif rec then
				if rec.img then rec.img:Destroy() end
				reg[o] = nil
			end
		end
		check()
		o:GetPropertyChangedSignal("Image"):Connect(check)
	end
	bind(gui.DescendantAdded, hook)
	for _, d in ipairs(gui:GetDescendants()) do hook(d) end
end)()

----------------------------------------------------------------- scheduler (one loop for everything)
task.spawn(function()
	local n = 0
	local lastProfileDisplayName = LP.DisplayName
	while alive do
		n += 1
		-- A changed DisplayName updates profile metadata only; UserId-based relationships stay intact.
		if LP.DisplayName ~= lastProfileDisplayName then
			lastProfileDisplayName = LP.DisplayName
			task.spawn(writeMyProfile)
			if FS and FS.writeProfile then task.spawn(FS.writeProfile) end
		end
		if CONFIG.HIDE_ROBLOX_CHAT and n % 2 == 1 then setRbxChat(false) end
		if REQUEST then
			if (isOpen and cur == 1) or n % 3 == 0 then pollStream(serverStream, serverHandler) end
			if isOpen and cur == 1 and n % 2 == 0 then pollReactions(serverStream.rpath, auth, FIREBASE_DB, views[1]) end
			if isOpen and cur == 2 and dmStream and thread.Visible then
				local s = dmStream
				pollStream(s, function(k, m, silent) if s == dmStream then dmHandler(k, m) end end)
				if s == dmStream and n % 2 == 0 then pollReactions(s.rpath, dmAuth, DM_FIREBASE_DB, views.dm) end
			end
			if n % 3 == 1 then pollInbox() end                 -- ~7.5s: ONE small request tells me who messaged
			if n % 12 == 8 and refreshNames() and home.Visible and isOpen and cur == 2 then refreshHome() end -- ~30s: keep Recent names current
			if n == 2 and not legacyDone then discoverLegacy() end -- once per install
			if n == 3 or n % 360 == 0 then syncDirectory() end -- Saiki users list (only changes since last sync)
			if n == 4 then task.spawn(writeMyProfile) end
			if n == 5 then task.spawn(loadFriends) end
			if n == 6 or (n % 60 == 0 and not FS.ok) then task.spawn(FS.init) end -- follower login + own profile
			if n % 120 == 0 and FS.ok then task.spawn(FS.loadMine) end        -- refresh my followers/following every ~5 min
			if n == 7 and home.Visible and isOpen and cur == 2 then refreshHome() end -- friends / directory just arrived
		end
		if n % 2 == 0 then flushAll(false) end
		task.wait(CONFIG.POLL)
	end
end)

----------------------------------------------------------------- cleanup + API
local function Destroy()
	if not alive then return end
	alive = false
	pcall(flushAll, true)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
