-- ================= TAB SWITCHING & THEME ENGINE =================
local pages = {
	Chat = ChatPage,
	Music = MusicPage,
	Theme = ThemePage,
}
local navButtons: { [string]: TextButton } = {}

local function createNavButton(name: string, labelText: string)
	local btn = Instance.new("TextButton")
	btn.Name = name .. "Tab"
	btn.Size = UDim2.new(1, 0, 0, 34)
	btn.Text = labelText
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.AutoButtonColor = false
	btn.Parent = Sidebar
	addCorner(btn, 7)

	btn.MouseButton1Click:Connect(function()
		for pageKey, pageFrame in pairs(pages) do
			pageFrame.Visible = (pageKey == name)
		end
		for btnKey, navBtn in pairs(navButtons) do
			local active = (btnKey == name)
			navBtn.BackgroundColor3 = active and currentTheme.Accent or currentTheme.SurfaceElevated
			navBtn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or currentTheme.TextSecondary
		end
	end)

	navButtons[name] = btn
end

