local function tween(inst: Instance, props: { [string]: any }, time: number?)
	TweenService:Create(
		inst,
		TweenInfo.new(time or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		props
	):Play()
end

local function round(parent: Instance, px: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px)
	c.Parent = parent
	return c
end

local function pillRound(parent: Instance)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = parent
	return c
end

local function hairStroke(parent: Instance, color: Color3, trans: number, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Transparency = trans
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function dragify(handle: GuiObject, target: GuiObject)
	local dragging = false
	local activeInput: InputObject? = nil
	local origin = Vector3.zero
	local startOffset = target.Position

	handle.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			origin = input.Position
			startOffset = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			activeInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and input == activeInput then
			local delta = input.Position - origin
			target.Position = UDim2.new(
				startOffset.X.Scale,
				startOffset.X.Offset + delta.X,
				startOffset.Y.Scale,
				startOffset.Y.Offset + delta.Y
			)
		end
	end)
end

