		end
		for _, sh in ipairs(shoots) do
			sh.t = sh.t - dt
			if sh.t <= 0 then
				sh.x, sh.y, sh.t = rng:NextNumber(0.3, 1.1), rng:NextNumber(-0.1, 0.3), rng:NextNumber(1.5, 3.5)
			end
			sh.x = sh.x - dt * 0.9
			sh.y = sh.y + dt * 0.63
			sh.f.Position = UDim2.fromScale(sh.x, sh.y)
		end
		if el >= DUR then finish() end
	end))
