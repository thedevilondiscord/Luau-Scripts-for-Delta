local function clean(s)
	s = tostring(s or ""):gsub("%c", " "):gsub("%s+", " ")
	s = s:match("^%s*(.-)%s*$") or ""
	local ok, cut = pcall(utf8.offset, s, CONFIG.MAX_LEN + 1)
	if ok and cut then s = s:sub(1, cut - 1) end
	return s
end
local function cut(s, n)
	s = tostring(s or "")
	local ok, pos = pcall(utf8.offset, s, n + 1)
	if ok and pos then return s:sub(1, pos - 1) end
	return s
end
