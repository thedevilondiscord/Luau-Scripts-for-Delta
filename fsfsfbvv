		local cache = {}
		pcall(function()
			if isfile and readfile and isfile(MODFILE) then
				local d = HttpService:JSONDecode(readfile(MODFILE))
				if type(d) == "table" and type(d.ids) == "table" then cache = d.ids end
			end
		end)
		local out = {}
		if list then
			T.modNames = list
			for _, nm in ipairs(list) do
				local low = nm:lower()
				local id
				if low == LP.Name:lower() then
					id = string.format("%.0f", LP.UserId)
				else
					local ok, res = pcall(function() return Players:GetUserIdFromNameAsync(nm) end)
					id = (ok and res) and string.format("%.0f", res) or cache[low]
				end
				if id then out[low] = id end
			end
			pcall(function() if writefile then writefile(MODFILE, HttpService:JSONEncode({ ids = out, t = os.time() })) end end)
		else
			out = cache -- offline: last known list
		end
		local set = {}
		for _, id in pairs(out) do set[tostring(id)] = true end
		ids, ready = set, true
	end

	-- everything moderators did, one small read: kicks, mutes, custom titles, secret frames
	local function parseMods(data)
		local mute, title, granted = {}, {}, {}
		local nowms = nowMs()
		for target, byMap in pairs(data.mute or {}) do
			local tid = tostring(target)
			if type(byMap) == "table" and not T.isMod(tid) then
				for by, rec in pairs(byMap) do
					if T.isMod(by) and type(rec) == "table" then
						local u = tonumber(rec["until"]) or 0
						if u == 0 or u > nowms then
							local prev = mute[tid]
							if prev == nil then mute[tid] = u elseif prev ~= 0 and (u == 0 or u > prev) then mute[tid] = u end
						end
					end
				end
			end
		end
		for target, byMap in pairs(data.title or {}) do
			local best, bt = nil, -1
			if type(byMap) == "table" then
				for by, rec in pairs(byMap) do
					if T.isMod(by) and type(rec) == "table" and type(rec.t) == "string" and rec.t ~= "" then
						local ts = tonumber(rec.ts) or 0
						if ts > bt then best, bt = rec.t, ts end
					end
				end
			end
			if best then title[tostring(target)] = best:sub(1, 24) end
		end
		for target, fmap in pairs(data.frame or {}) do
			if type(fmap) == "table" then
				for fkey, byMap in pairs(fmap) do
					if CONFIG.FRAMES[fkey] and type(byMap) == "table" then
						for by in pairs(byMap) do
							if T.isMod(by) then
								local tid = tostring(target)
								granted[tid] = granted[tid] or {}
								granted[tid][fkey] = true
							end
						end
					end
				end
			end
		end
		return mute, title, granted
	end

	-- a moderator kicked me (moderators themselves can't be kicked)
	local function checkKick(data)
		local recs = data.kick and data.kick[ME]
		if type(recs) ~= "table" or T.isMod(ME) then return end
		for by, rec in pairs(recs) do
			if T.isMod(by) and type(rec) == "table" then
				local ts = tonumber(rec.ts) or 0
				local key = tostring(by) .. ":" .. ts
				if ts > 0 and not handledKick[key] and nowMs() - ts < (CONFIG.MOD_KICK_TTL or 900) * 1000 then
					handledKick[key] = true
					local why = (type(rec.r) == "string" and rec.r ~= "") and ("\nReason: " .. rec.r:sub(1, 80)) or ""
					kick("You were kicked by a Saiki Rechat moderator." .. why)
					return
				end
			end
		end
	end

	local function pollMods()
		if not REQUEST or not ready then return end
		T.dmId()
		local ok, data = dbRequest("GET", "/mods", nil, dmAuth, DM_FIREBASE_DB)
		if not ok then return end
		if type(data) ~= "table" then data = {} end
		T.muted, T.customTitle, T.granted = parseMods(data)
		checkKick(data)
		if T.refreshFrames then pcall(T.refreshFrames) end
		if T.repaintTags then pcall(T.repaintTags) end
	end

	-------- commands
	local CMDS = { "!saikikick", "!saikianc", "!giveframe", "!saikicustomtitle", "!saikimute" }
	local function isCmd(w) for _, c in ipairs(CMDS) do if c == w then return true end end return false end

	-- username -> userId, also for players who are not in this server
	local function resolveUser(name)
		name = name:gsub("^@", "")
		local low = name:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower() == low or p.DisplayName:lower() == low then return string.format("%.0f", p.UserId), p.Name end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower():sub(1, #low) == low then return string.format("%.0f", p.UserId), p.Name end
		end
		local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(name) end)
		if ok and id then return string.format("%.0f", id), name end
		return nil
	end

	local function secretKeys() -- names moderators can give with !giveframe
		local out = {}
		for k in pairs(CONFIG.FRAMES) do
			if k == "rose" or k == "cursed" or k == "demon" then out[#out + 1] = k
			elseif k:sub(1, 2) == "x_" then out[#out + 1] = k:sub(3) end
		end
		table.sort(out, function(a, b) return a:lower() < b:lower() end)
		return out
	end
	local function frameKeyOf(word)
		local low = word:lower()
		low = low:gsub("^x_", "")
		for k in pairs(CONFIG.FRAMES) do
			local kl = k:lower()
			if (k == "rose" or k == "cursed" or k == "demon") and kl == low then return k end
			if k:sub(1, 2) == "x_" and kl:sub(3) == low then return k end
		end
		return nil
	end

	local function put(path, body) T.dmId(); return dbRequest("PUT", path, body, dmAuth, DM_FIREBASE_DB) end
	local function del(path) T.dmId(); return dbRequest("DELETE", path, nil, dmAuth, DM_FIREBASE_DB) end

	local function runCmd(view, cmd, args)
		if cmd == "!saikianc" then
			if args == "" then view.notice("Usage: !saikianc your announcement"); return end
			view.sendText("!anc " .. args) -- shows in THIS server only; moderators skip the tier check
			return
		end
		local who, rest = args:match("^(%S+)%s*(.*)$")
		if not who then view.notice("Usage: " .. cmd .. " <username> ..."); return end
		local id, shown = resolveUser(who)
		if not id then view.notice('No Roblox user called "' .. who .. '".'); return end
		local me = ME
		local ok, code
		if cmd == "!saikikick" then
			if T.isMod(id) then view.notice("Moderators can't be kicked."); return end
			ok, _, _, code = put("/mods/kick/" .. id .. "/" .. me, { ts = SV, r = cut(rest, 60) })
			view.notice(ok and ("Kick sent for " .. shown .. ". It works whether or not they are in this server: they are removed as soon as their Saiki Rechat checks in (within " .. math.floor((CONFIG.MOD_KICK_TTL or 900) / 60) .. " min).")
				or ("Couldn't send the kick (HTTP " .. tostring(code) .. "). Publish the new DM rules?"))
		elseif cmd == "!saikimute" then
			if T.isMod(id) then view.notice("Moderators can't be muted."); return end
			local a = rest:lower()
			if a == "off" or a == "unmute" then
				ok, _, _, code = del("/mods/mute/" .. id .. "/" .. me)
				view.notice(ok and (shown .. " is unmuted (by you).") or ("Couldn't unmute (HTTP " .. tostring(code) .. ")."))
			else
				local mins = tonumber(rest:match("^(%d+)"))
				local untilMs = mins and (nowMs() + mins * 60000) or 0
				ok, _, _, code = put("/mods/mute/" .. id .. "/" .. me, { ts = SV, ["until"] = untilMs })
				view.notice(ok and (shown .. " is muted " .. (mins and ("for " .. mins .. " min") or "until you unmute them (!saikimute " .. shown .. " off)") .. ".")
					or ("Couldn't mute (HTTP " .. tostring(code) .. ")."))
			end
		elseif cmd == "!saikicustomtitle" then
			if rest == "" then view.notice("Usage: !saikicustomtitle <username> <tag text | off>"); return end
			if rest:lower() == "off" then
				ok, _, _, code = del("/mods/title/" .. id .. "/" .. me)
				view.notice(ok and ("Custom tag removed from " .. shown .. ".") or ("Couldn't remove it (HTTP " .. tostring(code) .. ")."))
			else
				local t = cut(rest, 24)
				ok, _, _, code = put("/mods/title/" .. id .. "/" .. me, { ts = SV, t = t })
				view.notice(ok and (shown .. " now has the tag [" .. t .. "].") or ("Couldn't set the tag (HTTP " .. tostring(code) .. ")."))
			end
		elseif cmd == "!giveframe" then
			local fword, off = rest:match("^(%S+)%s*(%S*)$")
			if not fword then view.notice("Usage: !giveframe <username> <frame> [off]"); return end
			local key = frameKeyOf(fword)
			if not key then view.notice('Unknown secret frame "' .. fword .. '". Start typing it and pick a suggestion.'); return end
			if off:lower() == "off" then
				ok, _, _, code = del("/mods/frame/" .. id .. "/" .. key .. "/" .. me)
				view.notice(ok and ("Took the frame " .. fword .. " back from " .. shown .. ".") or ("Couldn't remove it (HTTP " .. tostring(code) .. ")."))
			else
				ok, _, _, code = put("/mods/frame/" .. id .. "/" .. key .. "/" .. me, SV)
				view.notice(ok and (shown .. " can now wear the frame " .. fword .. " (they pick it in Settings).") or ("Couldn't give the frame (HTTP " .. tostring(code) .. ")."))
			end
		end
		if ok then pollMods() end
	end

	-- called from the chat box; true = handled (the text is never sent as a message)
	function T.modCmd(view, txt)
		local cmd = txt:match("^(!%S+)")
		if not cmd then return false end
		cmd = cmd:lower()
		if not isCmd(cmd) then return false end
		if not ready then view.notice("The moderator list is still loading, try again in a moment."); return true end
		if not T.isMod(ME) then view.notice("Moderator commands are for Saiki Rechat moderators only."); return true end
		local args = txt:match("^%S+%s+(.*)$") or ""
		task.spawn(function()
			local ok, err = pcall(runCmd, view, cmd, args)
			if not ok then view.notice("Command failed: " .. tostring(err)) end
		end)
		return true
	end

	-- auto-fill chips for the chat box (moderators only)
	function T.modSuggest(text)
		if not (ready and T.isMod(ME)) or text:sub(1, 1) ~= "!" then return nil end
		local out = {}
		local word = text:match("^(!%S*)$")
		if word then
			local low = word:lower()
			for _, c in ipairs(CMDS) do
				if c:sub(1, #low) == low and c ~= low then out[#out + 1] = { label = c, fill = c .. " " } end
			end
			return out
		end
		local cmd, args = text:match("^(!%S+)%s(.*)$")
		if not cmd then return nil end
		cmd = cmd:lower()
		if not isCmd(cmd) or cmd == "!saikianc" then return nil end
		local first, tail = args:match("^(%S*)(.*)$")
		if tail == "" then -- still typing the username
			local low = first:lower()
			low = low:gsub("^@", "")
			for _, p in ipairs(Players:GetPlayers()) do
				local nm, dn = p.Name:lower(), p.DisplayName:lower()
				local hit = low == "" or nm:sub(1, #low) == low or dn:sub(1, #low) == low
					or (#low >= 2 and (nm:find(low, 1, true) ~= nil or dn:find(low, 1, true) ~= nil))
				local protected = (cmd == "!saikikick" or cmd == "!saikimute") and T.isMod(p.UserId)
				if hit and not protected then
					out[#out + 1] = { label = (p.DisplayName ~= p.Name) and (p.DisplayName .. " (@" .. p.Name .. ")") or p.Name, fill = cmd .. " " .. p.Name .. " " }
					if #out >= 6 then break end
				end
			end
			return out
		end
		local second = tail:match("^%s+(%S*)$") -- nil once a second word is finished
		if second == nil then return nil end
		local low = second:lower()
		if cmd == "!giveframe" then
			local cands = secretKeys()
			cands[#cands + 1] = "off"
			for _, k in ipairs(cands) do
				if low == "" or k:lower():sub(1, #low) == low then out[#out + 1] = { label = k, fill = cmd .. " " .. first .. " " .. k } end
				if #out >= 8 then break end
			end
		elseif cmd == "!saikimute" then
			for _, k in ipairs({ "off", "10", "30", "60", "1440" }) do
				if low == "" or k:sub(1, #low) == low then
					out[#out + 1] = { label = (k == "off") and "off (unmute)" or (k .. " min"), fill = cmd .. " " .. first .. " " .. k }
				end
			end
		elseif cmd == "!saikicustomtitle" then
			if low == "" or ("off"):sub(1, #low) == low then out[#out + 1] = { label = "off (remove tag)", fill = cmd .. " " .. first .. " off" } end
		end
		return out
	end

	task.spawn(function()
		pcall(loadMods)
		while alive do
			pcall(pollMods)
			task.wait(20)
		end
	end)
	task.spawn(function()
		while alive do
			task.wait(600)
			pcall(loadMods)
		end
	end)
end)()

