local function addMessage(author: string, message: string, tag: string?)
	local item = Instance.new("Frame")
	item.Size = UDim2.new(1, 0, 0, 0)
	item.AutomaticSize = Enum.AutomaticSize.Y
	item.BackgroundColor3 = Theme.Elevated
	item.BorderSizePixel = 0
	item.Parent = ChatList
	corner(item, 10)
	stroke(item, 1)

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = item

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.BackgroundTransparency = 1
	label.RichText = true
	label.TextWrapped = true
	label.TextColor3 = Theme.Text
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = tag and string.format("<b>%s</b> [%s]: %s", author, tag, message) or string.format("<b>%s</b>: %s", author, message)
	label.Parent = item

	task.defer(function()
		ChatList.CanvasPosition = Vector2.new(0, ChatList.AbsoluteCanvasSize.Y)
	end)
end

local function sendCurrentMessage()
	local trimmed = MessageBox.Text:match("^%s*(.-)%s*$")
	if not trimmed or trimmed == "" then
		return
	end
	MessageBox.Text = ""
	if SaikiRechat.Chat.OnSend then
		SaikiRechat.Chat.OnSend(trimmed)
	else
		addMessage(LocalPlayer.Name, trimmed)
	end
end

SendButton.MouseButton1Click:Connect(sendCurrentMessage)
MessageBox.FocusLost:Connect(function(enterPressed: boolean)
	if enterPressed then
		sendCurrentMessage()
	end
end)

SaikiRechat.Chat.AddMessage = addMessage

