----------------------------------------------------------------
-- PLAY SONG
----------------------------------------------------------------

local function playSong(song)

    if not song then
        return
    end

    State.current = song

    for index, item in ipairs(
        State.songs
    ) do

        if item.id == song.id then
            State.index = index
            break
        end
    end

    ensureVehicle()

    -- Send the song to the actual
    -- Brookhaven vehicle music system.

    local remoteOK =
        vehiclePlayMusic(
            song.id
        )

    -- Silent local sound is used only
    -- as a timing/controller reference.
    -- It is NOT audible.

    pcall(function()

        MusicSound:Stop()

        MusicSound.SoundId =
            "rbxassetid://"
            .. tostring(song.id)

        MusicSound.Volume = 0

        MusicSound.Looped = false

        MusicSound.TimePosition = 0

        MusicSound:Play()
    end)

    State.playing = true

    updatePlayerUI()

    StatusLabel.Text =
        remoteOK
        and "Playing"
        or "Vehicle remote unavailable"

    showToast(
        "Playing • "
        .. tostring(song.name)
    )
end

