-- A changed display name must reach everyone's Recent list: re-check a couple of recent names every ~30s
-- (UserId-based threads never change; only the label does). Returns true when something changed.
local function refreshNames()
	local now, checked, changed = os.time(), 0, false
	for pid, e in pairs(index) do
		if checked >= 2 then break end
		if e.l and (not e.nt or now - e.nt > 1800) then
			checked += 1
			e.nt = now
			local dn, un
			local pl = Players:GetPlayerByUserId(tonumber(pid) or 0)
			if pl then
				dn, un = pl.DisplayName, pl.Name
			else
				local d = directory[pid]
				if d and d.d ~= "" then dn, un = d.d, d.n end
				local ok, res = requestJSON("GET", "https://users.roblox.com/v1/users/" .. pid) -- Roblox is the source of truth
				if ok and type(res) == "table" and type(res.name) == "string" then
					dn = (type(res.displayName) == "string" and res.displayName ~= "") and res.displayName or res.name
					un = res.name
				end
			end
			if dn and dn ~= "" and (dn ~= e.n or (un and un ~= "" and un ~= e.u)) then
				e.n = cut(dn, 40)
				if un and un ~= "" then e.u = cut(un, 40) end
				changed = true
			end
			indexDirty = true
		end
	end
	return changed
end

