local function playEntry(i)
	local e = ENTRIES[i]
	if not e then return end
	curIdx, curFade = i, e.fade == true
	nameRow.Text = "Sound: " .. (e.name or "...")
	snd.SoundId = "rbxassetid://" .. e.id
	snd:Play()
	soundStatus.Text = "Loading sound..."
	refreshRows()
	task.delay(6, function()
		if snd.Parent and curIdx == i then
			if snd.IsLoaded then
				soundStatus.Text = e.fade and "Sound ready. Birds play in the morning/day, silent at night." or "Sound ready. Use the Volume slider."
			else
				soundStatus.Text = "This sound could not load. Pick another one."
			end
		end
	end)
end

