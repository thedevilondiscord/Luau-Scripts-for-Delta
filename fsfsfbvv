    track(b.Activated:Connect(function() set(not state) end))
    return set
end
local function slider(parent, titleText, min, max, initial, callback, suffix)
    local f = card(parent, 68)
    local t = label(f, titleText, 12, C.text, Enum.Font.GothamMedium); t.Position = UDim2.fromOffset(12, 7); t.Size = UDim2.new(0.7, 0, 0, 20)
    local val = label(f, tostring(initial) .. (suffix or ""), 11, C.sub); val.TextXAlignment = Enum.TextXAlignment.Right; val.Position = UDim2.new(0.72, 0, 0, 7); val.Size = UDim2.new(0.24, -12, 0, 20)
    local bar = create("Frame", {BackgroundColor3 = C.field, Position = UDim2.fromOffset(12, 42), Size = UDim2.new(1, -24, 0, 7)}, f); round(bar, 4)
    local fill = create("Frame", {BackgroundColor3 = C.accent, Size = UDim2.new(math.clamp((initial-min)/(max-min), 0, 1), 0, 1, 0)}, bar); round(fill, 4)
    local knob = create("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.text, Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)}, bar); round(knob, 10)
    local dragging = false
    local function setAt(x)
        local p = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local v = min + (max - min) * p
        v = math.floor(v * 100 + 0.5) / 100
        fill.Size = UDim2.new(p, 0, 1, 0); knob.Position = UDim2.new(p, 0, 0.5, 0)
        val.Text = tostring(v) .. (suffix or ""); if callback then callback(v) end
    end
    track(knob.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true end end))
    track(UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setAt(i.Position.X) end end))
    track(UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end))
    return function(v) local p = math.clamp((v-min)/(max-min), 0, 1); fill.Size = UDim2.new(p,0,1,0); knob.Position = UDim2.new(p,0,0.5,0); val.Text = tostring(v)..(suffix or "") end
end

