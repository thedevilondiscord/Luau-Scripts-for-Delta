	pBtn.Parent = PillTabs
	pillRound(pBtn)
	pBtn.MouseButton1Click:Connect(function()
		selectMode(modeName)
	end)
	pillButtons[modeName] = pBtn
end

local function applyNovolineTheme(name: string)
	local nextTheme = NovolineThemes[name]
	if not nextTheme then
		return
	end
	activeThemeName = name
	theme = nextTheme

	TopPill.BackgroundColor3 = theme.PillBg
	topPillStroke.Color = theme.Stroke
	topPillStroke.Transparency = theme.StrokeTrans

	BrandBadge.BackgroundColor3 = theme.AccentSoft
	BrandBadge.TextColor3 = theme.Accent

	Deck.BackgroundColor3 = theme.GlassBg
	Deck.BackgroundTransparency = theme.GlassTrans
	deckStroke.Color = theme.Stroke
	deckStroke.Transparency = theme.StrokeTrans

	DeckTitle.TextColor3 = theme.Muted
	Divider.BackgroundColor3 = theme.Stroke
	Divider.BackgroundTransparency = theme.StrokeTrans

	FilterBox.BackgroundColor3 = theme.CardBg
	FilterBox.TextColor3 = theme.Text
	FilterBox.PlaceholderColor3 = theme.Muted
	filterStroke.Color = theme.Stroke
	filterStroke.Transparency = theme.StrokeTrans

	Composer.BackgroundColor3 = theme.CardBg
	composerStroke.Color = theme.Stroke
	composerStroke.Transparency = theme.StrokeTrans
	ComposerInput.TextColor3 = theme.Text
	ComposerInput.PlaceholderColor3 = theme.Muted
	SendPill.BackgroundColor3 = theme.Accent
	SendPill.TextColor3 = Color3.fromRGB(14, 15, 18)

	for _, child in ipairs(MessageStream:GetChildren()) do
		if child:IsA("Frame") then
			child.BackgroundColor3 = theme.CardBg
			local lbl = child:FindFirstChildOfClass("TextLabel")
			if lbl then
				lbl.TextColor3 = theme.Text
			end
		end
	end

	NowPlayingCard.BackgroundColor3 = theme.CardBg
	npStroke.Color = theme.Stroke
	npStroke.Transparency = theme.StrokeTrans
	npTag.TextColor3 = theme.Accent
	SongLabel.TextColor3 = theme.Text
	ArtistLabel.TextColor3 = theme.Muted
	ElapsedLbl.TextColor3 = theme.Muted
	DurationLbl.TextColor3 = theme.Muted
	ScrubberTrack.BackgroundColor3 = theme.GlassBg
	ScrubberFill.BackgroundColor3 = theme.Accent

	for _, ctrl in ipairs({ PrevPill, NextPill }) do
		ctrl.BackgroundColor3 = theme.CardBg
		ctrl.TextColor3 = theme.Text
	end
	TogglePlayPill.BackgroundColor3 = theme.Accent
	TogglePlayPill.TextColor3 = Color3.fromRGB(14, 15, 18)

	StyleHeader.TextColor3 = theme.Muted
	DeckToggleBtn.BackgroundColor3 = theme.CardBg
	DeckToggleBtn.TextColor3 = theme.Text

	if Deck.Visible then
		depthBlur.Size = theme.GlassBlur
	end
	selectMode(currentMode)
end

for presetName in pairs(NovolineThemes) do
	local chip = Instance.new("TextButton")
	chip.Size = UDim2.fromOffset(128, 30)
	chip.Text = presetName
	chip.Font = Enum.Font.GothamBold
	chip.TextSize = 11
	chip.AutoButtonColor = false
	chip.BorderSizePixel = 0
	chip.Parent = ChipRow
	pillRound(chip)
	hairStroke(chip, theme.Stroke, 0.88, 1)
	chip.MouseButton1Click:Connect(function()
		applyNovolineTheme(presetName)
	end)
end

SaikiRechat.SetTheme = applyNovolineTheme

local deckVisible = true
local function setDeckVisible(state: boolean)
	deckVisible = state
	DeckToggleBtn.Text = deckVisible and "HIDE" or "SHOW"
	if deckVisible then
		Deck.Visible = true
		Deck.Position = UDim2.new(0.5, -280, 0, 56)
		tween(Deck, { Position = UDim2.new(0.5, -280, 0, 68), BackgroundTransparency = theme.GlassTrans }, 0.2)
		tween(depthBlur, { Size = theme.GlassBlur }, 0.2)
	else
		tween(Deck, { Position = UDim2.new(0.5, -280, 0, 56), BackgroundTransparency = 1 }, 0.16)
		tween(depthBlur, { Size = 0 }, 0.16)
		task.delay(0.17, function()
			if not deckVisible then
				Deck.Visible = false
			end
		end)
	end
end

DeckToggleBtn.MouseButton1Click:Connect(function()
	setDeckVisible(not deckVisible)
end)

applyNovolineTheme("Novoline")
pushChatLine("Novoline", "Pill & glass deck active. Ready for SaikiRechat.", "UI")

return SaikiRechat
