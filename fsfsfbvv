local function renderMessages()
    for _, child in ipairs(Feed:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local query = string.lower(search.Text)
    for index, item in ipairs(Chat.Messages) do
        local combined = string.lower(item.sender .. " " .. item.message .. " " .. (item.tag or ""))
        if query == "" or string.find(combined, query, 1, true) then
            local row = make("Frame", {
                BackgroundColor3 = Theme.Panel2,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, 58),
                LayoutOrder = index,
            }, Feed)
            corner(row, 11)
            local sender = label(row, item.sender .. (item.tag and ("  [" .. item.tag .. "]") or ""), 12, true, Theme.Accent)
            sender.Position = UDim2.fromOffset(12, 6)
            sender.Size = UDim2.new(1, -24, 0, 18)
            local body = label(row, item.message, 12, false)
            body.Position = UDim2.fromOffset(12, 27)
            body.Size = UDim2.new(1, -24, 0, 22)
            body.TextTruncate = Enum.TextTruncate.AtEnd
        end
    end
    task.defer(function()
        Feed.CanvasPosition = Vector2.new(0, math.max(0, feedLayout.AbsoluteContentSize.Y - Feed.AbsoluteSize.Y))
    end)
end

function Chat.AppendMessage(sender: string, message: string, tag: string?)
    if string.gsub(message, "%s", "") == "" then return end
    table.insert(Chat.Messages, { sender = sender, message = message, tag = tag })
    if #Chat.Messages > 150 then table.remove(Chat.Messages, 1) end
    renderMessages()
end

function Chat.SetSendCallback(callback: ((string) -> ())?)
    Chat.OnSend = callback
end

