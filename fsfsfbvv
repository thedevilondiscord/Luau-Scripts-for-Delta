local function fitScale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local base = math.min((vp.X - 24) / 475, (vp.Y - 24) / 375)
	local s = math.clamp(base, 0.5, 1) * (T.guiMul or 1) -- Settings > GUI size multiplies the fitted size
	return math.clamp(s, 0.5, math.max(0.5, base))
end
