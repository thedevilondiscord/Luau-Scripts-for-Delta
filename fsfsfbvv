-- FILTER
----------------------------------------------------------------

local function updateFilter()

    local query =
        string.lower(
            State.search or ""
        )

    State.filtered = {}

    for _, song in ipairs(
        State.songs
    ) do

        local categoryOK = false

        if State.category == "Liked" then

            categoryOK =
                State.liked[song.id] == true

        else

            categoryOK =
                song.category ==
                State.category
        end

        if categoryOK then

            local searchable =
                string.lower(
                    tostring(song.name)
                    .. " "
                    .. tostring(song.id)
                )

            if query == ""
                or string.find(
                    searchable,
                    query,
                    1,
                    true
                ) then

                table.insert(
                    State.filtered,
                    song
                )
            end
        end
    end
end

----------------------------------------------------------------
-- FALLBACK COVER
----------------------------------------------------------------

local function getFallbackCover(song)

    local number =
        tonumber(song.id)
        or 0

    local index =
        (number %
            #FALLBACK_COVERS)
        + 1

    return FALLBACK_COVERS[index]
end

----------------------------------------------------------------
-- COVER HANDLING
----------------------------------------------------------------

local coverRequest = 0

local function setCover(song)

    coverRequest += 1

    local requestNumber =
        coverRequest

    local fallback =
        getFallbackCover(song)

    -- First try the Roblox asset thumbnail.
    --
    -- If the asset doesn't have a usable
    -- thumbnail, ImageFailed will replace it
    -- with the supplied SAIKI fallback image.

    Cover.Image =
        "rbxthumb://type=Asset&id="
        .. tostring(song.id)
        .. "&w=420&h=420"

    local connection

    connection =
        Cover.ImageFailed:Connect(function()

            if requestNumber ~= coverRequest then
                return
            end

            Cover.Image =
                "rbxassetid://"
                .. tostring(fallback)

            if connection then
                connection:Disconnect()
            end
        end)

    task.delay(
        3,
        function()

            if connection then
                connection:Disconnect()
            end

            if requestNumber ~= coverRequest then
                return
            end

            -- If thumbnail hasn't produced a usable
            -- image, keep the fallback guaranteed.

            if Cover.Image == "" then
                Cover.Image =
                    "rbxassetid://"
                    .. tostring(fallback)
            end
        end
    )
end

